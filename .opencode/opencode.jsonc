{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"svelte": {
			"type": "remote",
			"url": "https://mcp.svelte.dev/mcp",
			"enabled": true
		},
		"postgres": {
			"type": "local",
			"command": ["pnpm", "dlx", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL}"],
			"enabled": false
		}
	}
}
