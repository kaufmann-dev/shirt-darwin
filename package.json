{
	"name": "shirt-darwin",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run --project server",
		"test:component": "vitest run --project client",
		"test:db": "vitest run --project server src/lib/server/db/schema.integration.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1103.0",
		"@aws-sdk/s3-request-presigner": "^3.1103.0",
		"@lucide/svelte": "^1.28.0",
		"@modelcontextprotocol/server": "2.0.0",
		"better-auth": "1.6.23",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.8",
		"mode-watcher": "^1.1.0",
		"pg-boss": "^12.27.0",
		"postgres": "^3.4.9",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/mcp": "^0.1.25",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.10.0",
		"@vitest/browser-playwright": "^4.1.8",
		"dotenv": "^17.2.3",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
